{
  "openapi": "3.0.3",
  "info": {
    "title": "Acme Core Banking API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/users": {
      "get": {
        "summary": "List all active users",
        "responses": {
          "200": {
            "description": "User list response"
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "summary": "Get user details",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile"
          }
        }
      }
    },
    "/api/v1/legacy-login": {
      "post": {
        "summary": "Legacy authentication endpoint",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "Token response"
          }
        }
      }
    }
  }
}
